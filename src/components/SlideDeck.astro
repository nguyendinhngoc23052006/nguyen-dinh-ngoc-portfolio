---
// biome-ignore-all lint/correctness/noUnusedImports: symbols used in the Astro template below the frontmatter fence, which biome cannot see
// biome-ignore-all lint/correctness/noUnusedVariables: constants used in the Astro template below the frontmatter fence, which biome cannot see
// A project's screens in use, one slide each: the screen, then what the person
// does and what then happens. Swipe, the arrow buttons or the arrow keys move
// between slides; every slide is a plain image and text, so the deck reads in
// order with no script, in print and in a screen reader.
import type { Lang } from "../data/portfolio";
import screens from "../data/screens.json";
import { decks } from "../data/slides";

interface Props {
  deck: string;
  lang: Lang;
  /** Names the deck for screen readers, e.g. "Mau Heritage Hub screens". */
  label: string;
}
const { deck, lang, label } = Astro.props;
const d = decks[deck];
if (!d) throw new Error(`no slide deck "${deck}" in src/data/slides.ts`);
const size = screens as Record<string, { width: number; height: number }>;
const total = d.slides.length;
const L = {
  en: {
    prev: "Previous screen",
    next: "Next screen",
    full: "Open full size",
    of: "of",
  },
  vi: {
    prev: "Màn hình trước",
    next: "Màn hình sau",
    full: "Xem kích thước đầy đủ",
    of: "/",
  },
}[lang];
---

<section class="deck" aria-roledescription={lang === "vi" ? "trình chiếu" : "carousel"} aria-label={label} data-deck>
  <p class="deck-note">{d.note[lang]}</p>
  <div class="deck-track" tabindex="0" aria-label={label}>
    {d.slides.map((s, i) => (
      <figure class="deck-slide" role="group" aria-roledescription={lang === "vi" ? "trang" : "slide"} aria-label={`${i + 1} ${L.of} ${total}`}>
        <a class="deck-frame" href={`/work/${s.image}.webp`} target="_blank" rel="noopener" title={L.full}>
          <img
            src={`/work/${s.image}.webp`}
            width={size[s.image].width}
            height={size[s.image].height}
            alt={s.title[lang]}
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </a>
        <figcaption>
          <p class="deck-count">{i + 1} {L.of} {total}</p>
          <h3 class="deck-title">{s.title[lang]}</h3>
          <p class="deck-text">{s.text[lang]}</p>
        </figcaption>
      </figure>
    ))}
  </div>
  {total > 1 && (
    <div class="deck-controls">
      <button type="button" class="deck-btn" data-prev aria-label={L.prev}>←</button>
      <span class="deck-pos" aria-live="polite" data-pos>1 {L.of} {total}</span>
      <button type="button" class="deck-btn" data-next aria-label={L.next}>→</button>
    </div>
  )}
</section>

<script>
  // One handler per deck on the page. The counter and the deck's height follow
  // the scroll position itself, so a swipe, a button and an arrow key all agree,
  // and the deck is only as tall as the slide on screen.
  for (const deck of document.querySelectorAll<HTMLElement>("[data-deck]")) {
    const track = deck.querySelector<HTMLElement>(".deck-track");
    const pos = deck.querySelector<HTMLElement>("[data-pos]");
    if (!track) continue;
    const slides = [...track.querySelectorAll<HTMLElement>(".deck-slide")];
    const sep = pos?.textContent?.match(/^\d+ (\S+) \d+$/)?.[1] ?? "of";
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");
    const left = (i: number) => slides[i].offsetLeft - slides[0].offsetLeft;
    let current = 0;
    const show = () => {
      const step = slides.length > 1 ? left(1) : 1;
      current = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / step)));
      if (pos) pos.textContent = `${current + 1} ${sep} ${slides.length}`;
      track.style.height = `${slides[current].offsetHeight}px`;
    };
    const go = (i: number) => {
      const to = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: left(to), behavior: still.matches ? "auto" : "smooth" });
    };
    deck.querySelector("[data-prev]")?.addEventListener("click", () => go(current - 1));
    deck.querySelector("[data-next]")?.addEventListener("click", () => go(current + 1));
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); go(current + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); go(current - 1); }
    });
    let frame = 0;
    const soon = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(show); };
    track.addEventListener("scroll", soon, { passive: true });
    window.addEventListener("resize", soon);
    for (const img of track.querySelectorAll("img")) img.addEventListener("load", soon);
    show();
  }
</script>

<style>
  .deck { margin-top: 1.5rem; }
  .deck-note { font-size: 0.8125rem; color: var(--muted-foreground); line-height: 1.5; }
  .deck-track {
    margin-top: 0.75rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    align-items: start;
    overflow-y: hidden;
    transition: height 0.2s ease;
    border-radius: 0.25rem;
  }
  .deck-track:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .deck-slide { scroll-snap-align: start; margin: 0; min-width: 0; }
  .deck-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    height: min(62vh, 560px);
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    overflow: hidden;
    cursor: zoom-in;
  }
  .deck-frame img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .deck-count { margin-top: 0.75rem; font-size: 0.75rem; color: var(--muted-foreground); letter-spacing: 0.04em; }
  .deck-title { margin-top: 0.25rem; font-weight: 600; font-size: 1.0625rem; line-height: 1.35; }
  .deck-text { margin-top: 0.375rem; font-size: 0.9375rem; line-height: 1.6; }
  .deck-controls { margin-top: 0.75rem; display: flex; align-items: center; gap: 0.75rem; }
  .deck-btn {
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--card);
    font-size: 1.125rem;
  }
  .deck-btn:hover { border-color: var(--accent); }
  .deck-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .deck-pos { font-size: 0.875rem; color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) {
    .deck-frame { height: auto; max-height: 70vh; }
    .deck-frame img { max-height: 70vh; }
  }
  @media (prefers-reduced-motion: reduce) { .deck-track { scroll-behavior: auto; transition: none; } }
  @media print {
    .deck-track { display: block; overflow: visible; height: auto !important; }
    .deck-slide { break-inside: avoid; margin-bottom: 1rem; }
    .deck-controls { display: none; }
  }
</style>
