---
// biome-ignore-all lint/correctness/noUnusedImports: symbols used in the Astro template below the frontmatter fence, which biome cannot see
import MobileNav from "../components/MobileNav";
import ThemeToggle from "../components/ThemeToggle";
import {
  aboutIntro,
  contactInfo,
  cvSkills,
  cvWork,
  heroSubhead,
  inTheWorks,
  navLinks,
  projects,
  projectsHeading,
  projectsSubhead,
  projectsTail,
  SITE_URL,
  stats,
  traits,
} from "../data/portfolio";
import "../styles/globals.css";

// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const DESCRIPTION =
  "Nguyen Dinh Ngoc (Jade) builds the internal systems a company runs on: ERP, HR, recruitment, attendance and payroll on Supabase + Cloudflare, with computer vision. Hanoi, open to remote.";

// biome-ignore lint/correctness/noUnusedVariables: used in Astro template
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE_URL}/#person`,
      name: "Nguyen Dinh Ngoc",
      alternateName: "Jade",
      jobTitle: "Internal Systems Developer",
      description:
        "Builds internal business systems: ERP, HR, recruitment, attendance and payroll, with computer vision.",
      url: SITE_URL,
      image: `${SITE_URL}/jade-avatar.jpg`,
      sameAs: ["https://github.com/nguyendinhngoc23052006"],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Hanoi",
        addressCountry: "VN",
      },
    },
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={DESCRIPTION} />
    <meta name="keywords" content="internal systems developer, ERP, HR software, payroll, attendance, recruitment workflow, Supabase, Cloudflare, computer vision, face recognition, Hanoi" />
    <meta name="author" content="Jade (Nguyen Dinh Ngoc)" />
    <link rel="canonical" href={SITE_URL} />
    <title>Jade — Internal Systems Developer | Nguyen Dinh Ngoc</title>
    <script is:inline src="/theme-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Jade — Internal Systems Developer" />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={`${SITE_URL}/jade-avatar.jpg`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Jade — Internal Systems Developer" />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="theme-color" content="#0a0a0a" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <>
        <a href="#about" class="skip-link">Skip to content</a>

        {/* ── NAV ── */}
        <header class="fixed inset-x-0 top-0 z-50 border-b border-border/40 bg-background/80 backdrop-blur-lg">
          <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-6" aria-label="Main navigation">
            <a href="/" class="text-sm font-bold tracking-tight">Jade</a>
            <div class="hidden items-center gap-5 lg:flex">
              {navLinks.map(({ href, label }) => (
                <a href={href} class="text-sm text-muted-foreground transition-colors hover:text-foreground">{label}</a>
              ))}
            </div>
            <div class="flex items-center gap-3">
              <ThemeToggle client:load />
              <MobileNav client:load />
            </div>
          </nav>
        </header>

        {/* ── HERO ── */}
        <section class="relative flex min-h-screen items-center overflow-hidden pt-14">
          <div class="relative mx-auto max-w-5xl px-6 flex flex-col-reverse items-start gap-10 lg:flex-row lg:items-center lg:justify-between">
            <div>
            <p class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">Jade</p>
            <h1 class="mt-2 text-5xl font-extrabold tracking-tighter sm:text-7xl lg:text-8xl">
              Nguyen<br />
              Dinh Ngoc
            </h1>

            <p class="mt-4 max-w-lg text-lg text-muted-foreground sm:text-xl">
              {heroSubhead}
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#work" class="inline-flex h-10 items-center gap-2 rounded-sm border border-foreground bg-foreground text-background px-6 text-sm font-medium transition-colors hover:bg-transparent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                See what I built
              </a>
              <a href="/cv" class="inline-flex h-10 items-center gap-2 rounded-sm border border-accent px-6 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                CV (EN / VI)
              </a>
            </div>
            </div>
            <img
              src="/jade-avatar.jpg"
              alt="Jade — Nguyen Dinh Ngoc, full-stack developer"
              width="280"
              height="280"
              loading="eager"
              class="rounded-sm border border-border/60 object-cover"
            />
          </div>
        </section>

        {/* ── STATS STRIP ── */}
        <section class="relative border-t border-border/40 bg-card/50 py-10" aria-label="Key facts">
          <div class="mx-auto max-w-5xl px-6">
            <div class="grid gap-6 sm:grid-cols-3">
              {stats.map(({ number, label }) => (
                <div class="text-center sm:text-left">
                  <p class="text-3xl font-extrabold tracking-tight sm:text-4xl">
                    {number}
                  </p>
                  <p class="mt-1 text-sm text-muted-foreground">{label}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* ── WORK: the systems, from the same entries as the CV ── */}
        <section id="work" class="border-t border-border/40 py-20 sm:py-28">
          <div class="mx-auto max-w-5xl px-6">
            <p class="section-label">Work</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Systems I built</h2>
            <p class="mt-3 max-w-2xl text-muted-foreground">Internal systems run on private company data, so they are described here rather than linked. Ask me and I'll walk you through any of them in an interview.</p>
            <div class="mt-10 grid gap-4 lg:grid-cols-2">
              {cvWork.map((w) => (
                <article class="rounded-sm border border-border/60 bg-card p-6">
                  <p class="text-xs font-medium uppercase tracking-widest text-accent">{w.status.en}</p>
                  <h3 class="mt-3 font-semibold tracking-tight">
                    {w.url ? <a href={w.url} target="_blank" rel="noopener noreferrer" class="hover:underline">{w.title.en} <span class="text-accent" aria-hidden="true">↗</span></a> : w.title.en}
                  </h3>
                  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-muted-foreground leading-relaxed">
                    {w.points.map((p) => <li>{p.en}</li>)}
                  </ul>
                  {w.discuss && (
                    <div class="mt-4 rounded-sm border-l-2 border-accent bg-secondary/30 px-3 py-2">
                      <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">Private system · happy to walk you through</p>
                      <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm leading-relaxed">
                        {w.discuss.map((d) => <li>{d.en}</li>)}
                      </ul>
                    </div>
                  )}
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {w.tags.map((t) => (
                      <span class="rounded-sm border border-border/60 bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">{t}</span>
                    ))}
                  </div>
                </article>
              ))}
            </div>
            <h3 class="mt-14 text-xl font-bold tracking-tight">In the works</h3>
            <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Hardware and AI products still in design. Details on request.</p>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {inTheWorks.map((x) => (
                <article class="rounded-sm border border-dashed border-border bg-card/50 p-5">
                  <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">In design · ask me</p>
                  <h4 class="mt-2 font-semibold tracking-tight">{x.title.en}</h4>
                  <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{x.line.en}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        {/* ── PROJECTS (proof-first — moved above About) ── */}
        <section id="projects" class="border-t border-border/40 py-20 sm:py-28">
          <div class="mx-auto max-w-5xl px-6">
            <p class="section-label">Projects</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{projectsHeading}</h2>
            <p class="mt-3 max-w-2xl text-muted-foreground">{projectsSubhead}</p>

            <div class="mt-10 grid gap-4 sm:grid-cols-3">
              {projects.map(({ num, title, desc, tags, status, url }) => {
                const shipped = status === "shipped";
                const Tag = url ? "a" : "div";
                const tagProps = url ? { href: url, target: "_blank", rel: "noopener noreferrer" } : {};
                return (
                  <Tag
                    {...tagProps}
                    class:list={[
                      "group relative block rounded-sm border bg-card p-6 transition-colors",
                      url ? "border-border/60 hover:border-accent" : "border-border/60",
                    ]}
                  >
                    <span class="text-4xl font-black text-muted-foreground select-none" aria-hidden="true">{num}</span>
                    <p
                      class:list={[
                        "mt-3 text-xs font-medium uppercase tracking-widest",
                        shipped ? "text-accent" : "text-muted-foreground",
                      ]}
                    >
                      {shipped ? "Live" : "Source"}
                    </p>
                    <h3 class="mt-3 font-semibold tracking-tight">
                      {title}
                      {url && <span class="ml-1 text-accent" aria-hidden="true">↗</span>}
                    </h3>
                    <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{desc}</p>
                    <div class="mt-4 flex flex-wrap gap-1.5">
                      {tags.map((t) => (
                        <span class="rounded-sm border border-border/60 bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                          {t}
                        </span>
                      ))}
                    </div>
                  </Tag>
                );
              })}
            </div>

            <div class="mt-8 flex items-center gap-4">
              <a href="https://github.com/nguyendinhngoc23052006" target="_blank" rel="noopener noreferrer" class="inline-flex h-10 items-center gap-2 rounded-sm border border-input bg-background px-6 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                Follow on GitHub <span aria-hidden="true">&rarr;</span>
              </a>
              <p class="text-sm text-muted-foreground">{projectsTail}</p>
            </div>
          </div>
        </section>

        {/* ── ABOUT ── */}
        <section id="about" class="border-t border-border/40 bg-card/50 py-20 sm:py-28">
          <div class="mx-auto max-w-5xl px-6">
            <p class="section-label">About</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Building from Vietnam, shipping globally</h2>

            <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_320px]">
              <div class="space-y-4 text-muted-foreground">
                <p>
                  {aboutIntro}
                </p>
                <p>
                  The work covers the whole stack — schema to UI to edge, every seam in between.
                  Internal dashboards, workflow automation, client portals, one-off tools for jobs
                  no template will fit. If the problem needs someone who can hold the business
                  logic, the data model, and the deploy pipeline in one head at once, that's the
                  seat I was built for.
                </p>
              </div>

              <aside class="border-l-4 border-accent bg-secondary/30 p-6 space-y-5">
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">Location</p>
                  <p class="mt-0.5 text-sm">Hanoi, Vietnam</p>
                </div>
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">Education</p>
                  <p class="mt-0.5 text-sm">Foreign Trade University (FTU)</p>
                </div>
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">Focus</p>
                  <p class="mt-0.5 text-sm">Internal systems · ERP · Automation · Computer vision</p>
                </div>
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">Status</p>
                  <p class="mt-0.5 text-sm text-accent">Open to full-time roles and projects</p>
                </div>
                <div>
                  <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">What I bring</p>
                  <ul class="mt-1 space-y-1 text-sm">
                    {traits.map((t) => (
                      <li>
                        <span class="font-semibold">{t.label.en}</span>
                        <span class="text-muted-foreground"> — {t.note.en}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <a href="/cv" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent hover:underline">
                  Full CV & résumé <span aria-hidden="true">→</span>
                </a>
              </aside>
            </div>
          </div>
        </section>

        {/* ── SKILLS ── */}
        <section id="skills" class="border-t border-border/40 bg-card/50 py-20 sm:py-28">
          <div class="mx-auto max-w-5xl px-6">
            <p class="section-label">Stack</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Technologies I work with</h2>

            <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {cvSkills.map(({ group, items }) => (
                <div class="rounded-sm border border-border/60 bg-background/50 p-5">
                  <p class="mb-3 text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">{group.en}</p>
                  <div class="flex flex-wrap gap-2">
                    {items.map((s) => (
                      <span class="rounded-sm border border-border/60 bg-secondary/30 px-2.5 py-0.5 text-xs font-medium">
                        {s}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* ── CONTACT ── */}
        <section id="contact" class="border-t border-border/40 py-20 sm:py-28">
          <div class="mx-auto max-w-xl px-6">
            <p class="section-label">Contact</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Get in touch</h2>
            <p class="mt-3 text-muted-foreground">
              Open to full-time roles in Hanoi or remote. Call or email me directly.
            </p>
            <ul class="mt-8 space-y-3 text-sm">
              {contactInfo.phone && (
                <li>
                  <span class="text-muted-foreground">Phone · </span>
                  <a href={`tel:${contactInfo.phone.replace(/\s/g, "")}`} class="font-medium hover:underline">{contactInfo.phone}</a>
                </li>
              )}
              <li>
                <span class="text-muted-foreground">Email · </span>
                <a href={`mailto:${contactInfo.email}`} class="font-medium hover:underline">{contactInfo.email}</a>
              </li>
              <li>
                <span class="text-muted-foreground">GitHub · </span>
                <a href={contactInfo.github} target="_blank" rel="noopener noreferrer" class="font-medium hover:underline">{contactInfo.github.replace("https://", "")}</a>
              </li>
              <li>
                <span class="text-muted-foreground">CV · </span>
                <a href="/cv" class="font-medium hover:underline">English</a>
                <span class="text-muted-foreground"> / </span>
                <a href="/cv/vi" class="font-medium hover:underline">Tiếng Việt</a>
              </li>
            </ul>
          </div>
        </section>

        {/* ── FOOTER ── */}
        <footer class="border-t border-border/40 py-8">
          <div class="mx-auto max-w-5xl px-6 text-center">
            <div class="flex justify-center gap-6">
              <a href="https://github.com/nguyendinhngoc23052006" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground transition-colors hover:text-foreground">GitHub</a>
              <a href="mailto:nguyendinhngoc23052006@gmail.com" class="text-sm text-muted-foreground transition-colors hover:text-foreground">Email</a>
            </div>
            <p class="mt-4 text-xs text-muted-foreground">
              &copy; {new Date().getFullYear()} Jade &middot; Nguyen Dinh Ngoc &middot; Internal systems from Hanoi
            </p>
          </div>
        </footer>

    </>
  </body>
</html>
