---
// biome-ignore-all lint/correctness/noUnusedImports: symbols used in the Astro template below the frontmatter fence, which biome cannot see
// biome-ignore-all lint/correctness/noUnusedVariables: constants used in the Astro template below the frontmatter fence, which biome cannot see
export const prerender = true;

import {
  contactInfo,
  cvSummary,
  education,
  experience,
  projects,
  SITE_URL,
  services,
  skills,
  traits,
} from "../data/portfolio";
import "../styles/globals.css";

// The CV allows up to 2 pages (enforced at build time by
// scripts/generate-cv-pdf.mjs). Content is organized so page 1 leads with
// identity → summary → traits → top 3 projects; page 2 (if used) carries
// education, full skills, services, and the footer.
const CV_PROJECTS = projects.slice(0, 3);
const CV_TRAITS = traits;
const CV_SKILLS = skills;
const CV_SERVICES = services;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Jade (Nguyen Dinh Ngoc) — CV" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/cv`} />
    <title>Jade — CV</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/theme-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <div class="cv-page mx-auto max-w-3xl px-6 py-16">
      <!-- Sticky screen-only nav: back to portfolio + download -->
      <div class="cv-actions no-print mb-8 flex items-center justify-between text-sm">
        <a href="/" class="underline">← Back to portfolio</a>
        <a
          href="/jade-cv.pdf"
          download="Jade-Nguyen-Dinh-Ngoc-CV.pdf"
          class="rounded-sm border border-foreground bg-foreground px-4 py-2 text-background hover:bg-transparent hover:text-foreground transition-colors"
        >
          Download PDF
        </a>
      </div>

      <!-- Header: identity + contact -->
      <header class="cv-header flex items-start justify-between gap-6">
        <div>
          <h1 class="text-4xl font-bold tracking-tight">Nguyen Dinh Ngoc <span class="text-muted-foreground font-normal">(Jade)</span></h1>
          <p class="mt-2 text-lg text-muted-foreground">Full-Stack Developer · {contactInfo.location}</p>
          <p class="mt-1 text-sm text-muted-foreground">
            <a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a> · <a href={contactInfo.github}>GitHub</a> · <a href={SITE_URL}>{SITE_URL.replace("https://", "")}</a>
          </p>
        </div>
        <img
          src="/jade-avatar.jpg"
          alt="Jade — Nguyen Dinh Ngoc"
          width="96"
          height="96"
          class="rounded-sm border border-border object-cover shrink-0"
          style="width:96px;height:96px"
        />
      </header>

      <hr class="my-6 border-border" />

      <!-- Summary -->
      <section>
        <h2 class="cv-section-title">Summary</h2>
        <p class="mt-2 leading-relaxed">{cvSummary}</p>
      </section>

      <!-- Traits: what you bring beyond the code -->
      <section class="mt-6">
        <h2 class="cv-section-title">What I bring</h2>
        <ul class="mt-2 space-y-1.5">
          {CV_TRAITS.map((t) => (
            <li class="text-sm leading-snug">
              <span class="font-semibold">{t.label}.</span>
              <span class="text-muted-foreground"> {t.note}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Projects (top 3, full descriptions, tag row for stack summary) -->
      <section class="mt-6">
        <h2 class="cv-section-title">Selected projects — all live in production</h2>
        <div class="mt-2 space-y-3">
          {CV_PROJECTS.map((p) => (
            <div>
              <h3 class="font-semibold">
                {p.title}
                {p.status === "shipped" && (
                  <span class="ml-2 text-[10px] font-medium uppercase tracking-widest text-accent">Live</span>
                )}
                {p.url && (
                  <a href={p.url} class="ml-2 text-xs text-accent hover:underline">
                    {p.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                  </a>
                )}
              </h3>
              <p class="mt-1 text-sm leading-snug">{p.desc}</p>
              <p class="mt-1 text-xs text-muted-foreground">{p.tags.join(" · ")}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Experience (only if non-empty) -->
      {experience.length > 0 && (
        <section class="mt-6">
          <h2 class="cv-section-title">Experience</h2>
          <div class="mt-2 space-y-3">
            {experience.map((e) => (
              <div>
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-semibold">{e.role} · {e.organization}</h3>
                  <span class="text-sm text-muted-foreground shrink-0">{e.period}</span>
                </div>
                <p class="mt-1 text-sm leading-snug">{e.summary}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Education -->
      <section class="mt-6">
        <h2 class="cv-section-title">Education</h2>
        <div class="mt-2">
          {education.map((e) => (
            <div class="flex items-baseline justify-between gap-4">
              <div>
                <span class="font-semibold">{e.degree}</span>
                <span class="text-sm text-muted-foreground"> · {e.institution}, {e.location}</span>
              </div>
              <span class="text-sm text-muted-foreground shrink-0">{e.period}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Skills: all groups, two-column for density -->
      <section class="mt-6">
        <h2 class="cv-section-title">Technical skills</h2>
        <dl class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5 text-sm">
          {CV_SKILLS.map(({ group, items }) => (
            <div>
              <dt class="font-semibold">{group}</dt>
              <dd class="text-muted-foreground">{items.join(" · ")}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- Services offered -->
      <section class="mt-6">
        <h2 class="cv-section-title">Services offered</h2>
        <ul class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1 text-sm">
          {CV_SERVICES.map((s) => (
            <li>
              <span class="font-semibold">{s.title}.</span>
              <span class="text-muted-foreground"> {s.desc}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Footer for print: portfolio URL -->
      <footer class="cv-footer mt-8 pt-3 border-t border-border text-xs text-muted-foreground">
        Full portfolio · <a href={SITE_URL}>{SITE_URL.replace("https://", "")}</a>
      </footer>
    </div>
  </body>
</html>
