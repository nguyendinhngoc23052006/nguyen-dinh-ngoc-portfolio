---
export const prerender = true;

// biome-ignore lint/correctness/noUnusedImports: symbols used in the Astro template below the frontmatter fence, which biome cannot see
import {
  contactInfo,
  cvSummary,
  education,
  experience,
  projects,
  SITE_URL,
  services,
  skills,
  traits,
} from "../data/portfolio";
import "../styles/globals.css";

// One-page CV: cap arrays so print stays on a single A4 page.
// generate-cv-pdf.mjs enforces the ceiling at build time (fails if > 1 page).
// First-sentence-only for CV blurbs; portfolio pages keep the full descriptions.
const firstSentence = (s: string) => s.split(/(?<=[.!?])\s+/)[0] ?? s;
const CV_PROJECTS = projects.slice(0, 3).map((p) => ({ ...p, desc: firstSentence(p.desc) }));
const CV_SKILLS = skills.slice(0, 4);
const CV_TRAITS = traits.slice(0, 4);
const CV_SERVICES_LINE = services.map((s) => s.title).join(" · ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Jade (Nguyen Dinh Ngoc) — CV" />
    <meta name="robots" content="noindex" />
    <title>Jade — CV</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/theme-init.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <div class="cv-page mx-auto max-w-3xl px-6 py-16">
      <!-- Sticky screen-only nav: back to portfolio + download -->
      <div class="cv-actions no-print mb-8 flex items-center justify-between text-sm">
        <a href="/" class="underline">← Back to portfolio</a>
        <a
          href="/jade-cv.pdf"
          download="Jade-Nguyen-Dinh-Ngoc-CV.pdf"
          class="rounded-sm border border-foreground bg-foreground px-4 py-2 text-background hover:bg-transparent hover:text-foreground transition-colors"
        >
          Download PDF
        </a>
      </div>

      <!-- CV header -->
      <header class="cv-header flex items-start justify-between gap-6">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Nguyen Dinh Ngoc <span class="text-muted-foreground font-normal">(Jade)</span></h1>
          <p class="mt-1 text-base text-muted-foreground">Full-Stack Developer · {contactInfo.location}</p>
          <p class="mt-0.5 text-sm text-muted-foreground">
            <a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a> · <a href={contactInfo.github}>GitHub</a> · <a href={SITE_URL}>{SITE_URL.replace("https://", "")}</a>
          </p>
        </div>
        <img
          src="/jade-avatar.jpg"
          alt="Jade — Nguyen Dinh Ngoc"
          width="80"
          height="80"
          class="rounded-sm border border-border object-cover shrink-0"
          style="width:80px;height:80px"
        />
      </header>

      <hr class="my-5 border-border" />

      <!-- Summary -->
      <section>
        <h2 class="cv-section-title">Summary</h2>
        <p class="mt-1.5 text-sm leading-snug">{cvSummary}</p>
      </section>

      <!-- Traits inline: bold labels, one line, notes tucked as muted text -->
      <section class="mt-3">
        <h2 class="cv-section-title">What I bring</h2>
        <p class="mt-1 text-sm">
          {CV_TRAITS.map((t, i) => (
            <span>
              {i > 0 && <span class="text-muted-foreground"> · </span>}
              <span class="font-semibold">{t.label}</span>
              <span class="text-muted-foreground"> ({t.note})</span>
            </span>
          ))}
        </p>
      </section>

      <!-- Projects (top 3, one-liner format) -->
      <section class="mt-3">
        <h2 class="cv-section-title">Selected projects — all live in production</h2>
        <div class="mt-1 space-y-1">
          {CV_PROJECTS.map((p) => (
            <div class="text-sm leading-snug">
              <span class="font-semibold">{p.title}</span>
              {p.url && (
                <a href={p.url} class="ml-2 text-xs text-accent hover:underline">
                  {p.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                </a>
              )}
              <span class="text-muted-foreground"> — {p.desc}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Experience (only if non-empty) -->
      {experience.length > 0 && (
        <section class="mt-4">
          <h2 class="cv-section-title">Experience</h2>
          <div class="mt-1.5 space-y-2">
            {experience.map((e) => (
              <div>
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="text-sm font-semibold">{e.role} · {e.organization}</h3>
                  <span class="text-xs text-muted-foreground shrink-0">{e.period}</span>
                </div>
                <p class="mt-0.5 text-sm leading-snug">{e.summary}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Education -->
      <section class="mt-4">
        <h2 class="cv-section-title">Education</h2>
        <div class="mt-1.5">
          {education.map((e) => (
            <div class="flex items-baseline justify-between gap-4">
              <div>
                <span class="text-sm font-semibold">{e.degree}</span>
                <span class="text-xs text-muted-foreground"> · {e.institution}, {e.location}</span>
              </div>
              <span class="text-xs text-muted-foreground shrink-0">{e.period}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Skills (top 4 groups, two columns for density) -->
      <section class="mt-4">
        <h2 class="cv-section-title">Technical skills</h2>
        <dl class="mt-1.5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1 text-sm">
          {CV_SKILLS.map(({ group, items }) => (
            <div class="flex gap-2">
              <dt class="font-semibold shrink-0">{group}:</dt>
              <dd class="text-muted-foreground">{items.join(" · ")}</dd>
            </div>
          ))}
        </dl>
      </section>

      <!-- Footer for print: services one-liner + portfolio URL -->
      <footer class="cv-footer mt-4 pt-2 border-t border-border text-[10px] text-muted-foreground">
        Services · {CV_SERVICES_LINE}<br />
        Full portfolio · <a href={SITE_URL}>{SITE_URL.replace("https://", "")}</a>
      </footer>
    </div>
  </body>
</html>
