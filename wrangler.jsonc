{
  "name": "nguyen-dinh-ngoc-portfolio",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    // Astro emits /cv as the canonical URL (trailingSlash: "never") but the
    // built file is /cv/index.html. Without this setting Cloudflare Assets'
    // default `auto-trailing-slash` 301s /cv → /cv/, which then loops against
    // any explicit trailing-slash-strip rule.
    "html_handling": "drop-trailing-slash"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true
    }
  }
}
